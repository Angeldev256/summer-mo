# ---- Database ----
# Local SQLite file (the default when nothing is set).
DATABASE_URL=file:data/summer-mo.db
DATABASE_AUTH_TOKEN=
# On Vercel, connecting Turso from the Storage tab sets TURSO_DATABASE_URL and TURSO_AUTH_TOKEN,
# which also work. Or set DATABASE_URL=libsql://<db>.turso.io and DATABASE_AUTH_TOKEN yourself.

# ---- First login (for hosts where you can't run `npm run setup`, like Vercel) ----
# Creates this account once, only while no account exists. At least 10 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---- Images ----
# Set automatically when you connect Vercel Blob. Without it, images go to data/uploads.
BLOB_READ_WRITE_TOKEN=
